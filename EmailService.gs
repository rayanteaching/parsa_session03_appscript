function sendInitialStudentEmail_(record){var subject='نتیجه بخش تستی — '+CONFIG.SESSION_TITLE;var body='پارسا عزیز،\n\nپاسخ رسمی شما ثبت شد.\nنمره تستی: '+record.mcqScore+' از '+CONFIG.MCQ_MAX+'\n\nبخش‌های کدنویسی پس از بررسی مدرس نمره‌گذاری می‌شوند.';MailApp.sendEmail({to:getStudentEmail_(),subject:subject,body:body,name:'Python Session 3'});}
function sendTeacherSubmissionEmail_(record,row){var body=['ارسال جدید پارسا','Row: '+row,'MCQ: '+record.mcqScore+'/'+CONFIG.MCQ_MAX,'','Code Repair:',record.debugCodes.join('\n\n---\n\n'),'','Final Coding:',record.finalCode,'','پس از تصحیح ستون‌های ManualDebugScore و ManualCodingScore را پر کن.'].join('\n');MailApp.sendEmail({to:getTeacherEmail_(),subject:'ارسال جدید — '+CONFIG.SESSION_TITLE,body:body,name:'Python Session 3'});}
function sendFinalStudentEmail_(sub,debugScore,codingScore,finalScore,feedback){var body='پارسا عزیز،\n\nبررسی جلسه کامل شد.\nتستی: '+sub.MCQScore+'/'+CONFIG.MCQ_MAX+'\nاصلاح کد: '+debugScore+'/'+CONFIG.DEBUG_MAX+'\nتمرین نهایی: '+codingScore+'/'+CONFIG.CODING_MAX+'\nنمره نهایی: '+finalScore+'/'+CONFIG.TOTAL_MAX+(feedback?'\n\nبازخورد مدرس:\n'+feedback:'');MailApp.sendEmail({to:getStudentEmail_(),subject:'نمره نهایی — '+CONFIG.SESSION_TITLE,body:body,name:'Python Session 3'});}

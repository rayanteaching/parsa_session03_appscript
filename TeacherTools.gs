function sendFinalEmailForLatestSubmission(){validateConfig_();var lock=LockService.getScriptLock();lock.waitLock(30000);try{var sub=findStudentSubmission_();if(!sub)throw new Error('ارسال رسمی پیدا نشد.');if(String(sub.FinalEmailSent).toLowerCase()==='true'||sub.FinalEmailSent===true)throw new Error('ایمیل نهایی قبلاً ارسال شده است.');var d=parseManualScore_(sub.ManualDebugScore,0,CONFIG.DEBUG_MAX,'ManualDebugScore'),c=parseManualScore_(sub.ManualCodingScore,0,CONFIG.CODING_MAX,'ManualCodingScore'),f=Math.min(CONFIG.TOTAL_MAX,Number(sub.MCQScore)+d+c),feedback=String(sub.TeacherFeedback||'').trim();sendFinalStudentEmail_(sub,d,c,f,feedback);var s=ensureResultsSheet_();setCellByHeader_(s,sub.rowNumber,'FinalScore',f);setCellByHeader_(s,sub.rowNumber,'Status','FINAL');setCellByHeader_(s,sub.rowNumber,'FinalEmailSent',true);setCellByHeader_(s,sub.rowNumber,'FinalEmailSentAt',new Date());return f;}finally{lock.releaseLock();}}
function parseManualScore_(v,min,max,name){if(v===''||v===null||typeof v==='undefined')throw new Error(name+' هنوز پر نشده است.');var n=Number(v);if(!isFinite(n)||n<min||n>max)throw new Error(name+' باید بین '+min+' و '+max+' باشد.');return n;}
function setCellByHeader_(sheet,row,header,value){var col=RESULT_HEADERS.indexOf(header)+1;if(col<=0)throw new Error('Header پیدا نشد: '+header);sheet.getRange(row,col).setValue(value);}
function resetParsaSubmissionForTesting(){validateConfig_();var email=getStudentEmail_().toLowerCase(),s=ensureResultsSheet_();for(var row=s.getLastRow();row>=2;row--){if(String(s.getRange(row,3).getValue())===CONFIG.SESSION_KEY&&String(s.getRange(row,5).getValue()).toLowerCase()===email)s.deleteRow(row);}return 'ارسال‌های آزمایشی پاک شدند.';}

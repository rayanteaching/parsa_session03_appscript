{
  "attemptPolicy": {
    "mode": "first_official_then_practice",
    "practiceAttempts": "unlimited",
    "officialAttempt": "first_completed",
    "practiceMayChangeOfficialGrade": false
  },
  "repositoryWritePolicy": {
    "defaultBranch": "main",
    "directWritesToDefaultBranchAllowed": false,
    "writeBranchPrefixes": ["task/", "fix/", "harness/"],
    "explicitBranchRequiredForRemoteWrites": true,
    "documentationChangesExempt": false
  },
  "appsScriptWorkflow": {
    "sourceOfTruth": "github_repository",
    "mutationBridge": "verified_local_clone_with_clasp",
    "localCloneRequired": true,
    "manualAppsScriptSourceEditingAllowed": false,
    "manualAppsScriptProjectCreationAllowed": false,
    "claspEnvironmentMustBeObservedBeforeProvisioning": true,
    "requiredClaspObservations": ["clasp --version", "clasp create-script --help"],
    "provisioningMode": "direct_owner_command_after_preflight",
    "creationScriptType": "standalone",
    "webAppConfiguredAtDeployment": true,
    "remoteCreationHiddenInsideWrapperAllowed": false,
    "claspSyntaxMayBeInferredFromChatHistory": false,
    "claspSyntaxMayBeInferredFromRemoteDocsWithoutLocalHelp": false,
    "preflightCommand": "npm run clasp:preflight",
    "claspCreateRequiresOwnerApproval": true,
    "claspPushRequiresOwnerApproval": true,
    "productionDeployRequiresOwnerApproval": true,
    "claspConfigTracked": false
  },
  "sessionIsolation": {
    "sessionKey": "PARSA_S03",
    "reusePriorSessionRuntimeIds": false,
    "publicRepository": true,
    "studentPrivateDataAllowedInRepo": false
  }
}
